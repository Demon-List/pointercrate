main-list = Hauptliste
    .info = Der Hauptbereich der Demonlist. Diese Demons sind die herausforderndsten im Spiel. Rekorde werden über einer Mindestanforderung angenommen und mit einer großen Anzahl an Punkten belohnt!

extended-list = Erweiterte Liste
    .info = Diese Demons qualifizieren sich nicht mehr für die Hauptliste, aber sind dennoch von hoher Relevanz. Nur 100%-Rekorde werden hier angenommen! Beachte, dass non 100%-Rekorde welche eingereicht wurden bevor der Demon von der Hauptliste gefallen ist, beibehalten werden.

legacy-list = Legacy Liste
    .info = Diese Demons waren ursprünglich auf der Liste, aber sind runtergefallen, je mehr neue Demons über sie hinzugefügt wurden. Diese sind aus nostalgischen Gründen hier. Sie besitzt keine Reihenfolge, wird nicht mehr Instandgehalten und neu eingereichte Rekorde werden für diese Demons nicht akzeptiert.

demon-info = Veröffentlicht von { $publisher }
    .score = { $minimal-score } ({ $requirement }%) — { $total-score } (100%) Punkte
    .score-short = { $score } Punkte

## Time machine
time-machine = Zeitmaschine
    .info = Gib das Datum ein, für das du die Demonlist ansehen willst. Aus technischen Gründen ist das früheste Datum der 4. Januar 2017. Beachte jedoch, dass alle Daten vor dem 4. August 2017 nicht eindeutig akkurat ist, und eine 100%ige Genauigkeit nicht garantiert werden kann. Insbesondere enthalten Daten vor dem 4. April 2017 erhebliche Fehler!

    .destination-field = Ziel:
    .submit = Los!

    .destination-validator-valuemissing = Bitte gebe einen Wert an
    .destination-validator-rangeunderflow = Soweit zurück kannst du nicht reisen!

    .active-position = Zurzeit #{ $position }
    .active-position-legacy = Zurzeit Legacy
    .active-position-none = Zurzeit nicht auf der Liste vorhanden

    .active-info = Die Demonliste, so wie sie war am
    .return = Zurück zur Gegenwart

## Sidebar panels
editors-panel = Listenbearbeiter
    .info = Wende dich an eine dieser Personen, falls du Probleme mit der Liste hast oder etwas verändert sehen willst.

helpers-panel = Listenhelfer
    .info = Wende dich an eine dieser Personen, falls du Fragen dazu hast, warum ein bestimmter Rekord abgelehnt wurde. Belästige sie jedoch nicht unnötig mit Anfragen, warum ein bestimmer Rekord noch nicht eingetragen wurde!

guidelines-panel = Richtlinien
    .info = Alle Demonlistabläufe erfolgen gemäß unserer Richtlinien. Bitte lies dir diese vor dem Einreichen eines Rekords durch, um einen reibungslosen Ablauf zu haben!
    .button = Lese die Richtlinien!

submission-panel = Rekorde einreichen
    .info = Bitte reiche keinen Blödsinn ein, das macht es für uns alle nur schwieriger und führt potenziell zu einem Ausschluss von der Demonlist. Beachte ebenfalls, dass das Formula mehrfach gestellte Rekorde automatisch ablehnt.
    .button = Rekord einreichen!

statsviewer-panel = Stats anschauen
    .info = Erhalte einen detaillierten Überblick darüber, wer die meisten oder schwersten Demons geschafft / erstellt hat! Es gibt sogar eine Rangliste wo du dich mit den besten Benutzern vergleichen kannst!
    .button = Schau die Stats an!

discord-panel-info = Tritt dem offiziellen Discord-Server der Demonlist bei, wo du in Kontakt mit dem Demonlist Team treten kannst!
